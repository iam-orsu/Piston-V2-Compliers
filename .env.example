# Copy this file to .env and adjust values for your host.
# docker-compose.yaml reads these variables at startup.
# Defaults (shown here) are tuned for a 128 GB RAM / 96 vCPU production server.

# Memory cap per API replica (3 replicas × this value must fit in your RAM).
# 128 GB server:  PISTON_API_MEM_LIMIT=42g   (3 × 42 = 126 GB)
# 32 GB server:   PISTON_API_MEM_LIMIT=8g    (3 × 8  = 24 GB)
# 16 GB server:   PISTON_API_MEM_LIMIT=4g    (3 × 4  = 12 GB)
# 8 GB server:    PISTON_API_MEM_LIMIT=2g    (3 × 2  = 6 GB — reduce MAX_CONCURRENT_JOBS too)
PISTON_API_MEM_LIMIT=42g

# Memory cap for the terminal WebSocket service.
# Scales with MAX_SESSIONS: ~4 MB per active session is a safe estimate.
# 1000 sessions → 4 GB;  200 sessions → 1 GB
TERMINAL_MEM_LIMIT=4g
